{
  "name": "vue-tray-color-picker",
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@10.12.1",
  "description": "An opinionated Vue 3 colour picker: a floating swatch tray over a constrained hue and shade ladder, so every colour a user can reach is one worth shipping.",
  "author": "Fabian Kirchhoff",
  "license": "MIT",
  "homepage": "https://github.com/fabkho/vue-tray-color-picker#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fabkho/vue-tray-color-picker.git"
  },
  "bugs": {
    "url": "https://github.com/fabkho/vue-tray-color-picker/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "color",
    "colour",
    "color-picker",
    "colour-picker",
    "swatch",
    "palette",
    "hsl",
    "hex",
    "popover",
    "component"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "vite build",
    "dev": "pnpm --filter playground dev",
    "test": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:all": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@commitlint/types": "^21.2.0",
    "@eslint/js": "^9.20.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/browser": "^3.2.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.20.0",
    "eslint-plugin-vue": "^10.0.0",
    "fallow": "^3.16.0",
    "husky": "^9.1.7",
    "jiti": "^2.4.2",
    "playwright": "^1.50.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.57.0",
    "vite": "^7.0.0",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^3.2.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.2.0"
  }
}
